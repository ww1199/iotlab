15. Observe LED, buzzer, and serial message.

CREATE SKETCH:
exp9_intrusion.ino

CODE START
#define TRIG 4
#define ECHO 16
#define LED 22
#define BUZ 23

long duration;
float distance;

void setup() {
    Serial.begin(9600);

    pinMode(TRIG, OUTPUT);
    pinMode(ECHO, INPUT);
    pinMode(LED, OUTPUT);
    pinMode(BUZ, OUTPUT);

    digitalWrite(TRIG, LOW);
    digitalWrite(LED, LOW);
    digitalWrite(BUZ, LOW);
}

void loop() {
    digitalWrite(TRIG, LOW);
    delayMicroseconds(2);

    digitalWrite(TRIG, HIGH);
    delayMicroseconds(10);

    digitalWrite(TRIG, LOW);

    duration = pulseIn(ECHO, HIGH);

    distance = duration * 0.0343 / 2;

    Serial.print("Distance in CM: ");
    Serial.println(distance);

    if (distance <= 20 && distance > 0) {
        digitalWrite(LED, HIGH);
        digitalWrite(BUZ, HIGH);

        Serial.println("INTRUDER DETECTED!");
    } else {
        digitalWrite(LED, LOW);
        digitalWrite(BUZ, LOW);
    }

    delay(1000);
}
CODE END

EXPECTED WHEN OBJECT IS NEAR:
Distance: about 15 cm
INTRUDER DETECTED!
LED: ON
BUZZER: ON

EXPECTED WHEN OBJECT IS FAR:
Distance: about 35 cm
No Intruder Detected
LED: OFF
BUZZER: OFF

RESULT:
The ultrasonic sensor successfully detected objects within 20 cm and activated the LED and buzzer as an intruder alert.


